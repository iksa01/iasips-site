{#- The margin ledger (Model D, Kalyan 2026-11-22): every detail of an entry in one narrow column at its left —
    the day (itself the permalink in the stream), the month and year, the categories, the reading time.
    In the stream a second entry of the same day shows a dash in place of the date, like a diary.
    Expects: sd (date), stags, slink (permalink url or ""), smins (minutes or ""), supdated (date or ""), sagain. -#}
<div class="side{% if sagain %} s-again{% endif %}">
{%- set dayHtml %}<time datetime="{{ sd | dateISO }}"><span class="s-num">{{ sd.getUTCDate() }}</span> <span class="s-mon">{{ sd | monthName | truncate(3, true, "") }} {{ sd | year }}</span></time>{% endset %}
{%- if slink %}<a class="s-day" href="{{ slink }}" title="Permalink">{{ dayHtml | safe }}</a>{% else %}<span class="s-day">{{ dayHtml | safe }}</span>{% endif %}
{%- if supdated %}<span class="s-item">Updated <time datetime="{{ supdated | dateISO }}">{{ supdated.getUTCDate() }} {{ supdated | monthName | truncate(3, true, "") }}</time></span>{% endif %}
{%- if stags and stags.length %}<span class="s-item">{% for t in stags %}<a href="/journal/category/{{ t | slugify }}/">{{ t }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}
{%- if smins %}<span class="s-item">{{ smins }} min read</span>{% endif %}
</div>
