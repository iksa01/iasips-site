{#- Four plain links (2026-11 design); the page names, not the old card labels. -#}
{%- set links = [["/journal/", "Journal"], ["/archive/", "Archive"], ["/about/", "About"], ["/contact/", "Contact"]] %}
<nav aria-label="Site">
<ul>
{%- for l in links %}
<li><a href="{{ l[0] }}"{% if page.url.startsWith(l[0]) %} aria-current="page"{% endif %}>{{ l[1] }}</a></li>
{%- endfor %}
</ul>
</nav>
