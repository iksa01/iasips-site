{#- One journal-index entry, v4 shape: h3 title, h4 date, blurb, meta. Expects: e -#}
{%- if e.data.type == "quote" %}
{%- set qhtml = e.templateContent %}
{%- include "partials/quote-panel.njk" %}
<h4>{{ e.date | dateLong | safe }}</h4>
<p class="meta">{% if e.data.tags and e.data.tags.length %}Archived in {{ e.data.tags | join(" | ") }} <br>{% endif %}<a href="{{ e.url }}">Permanent link &rarr;</a></p>
{%- else %}
<h3><a href="{{ e.url }}">{{ e.data.title }}</a></h3>
<h4>{{ e.date | dateLong | safe }}</h4>
<p class="blurb">{{ e.templateContent | firstParagraph | safe }}</p>
<p class="meta">{% if e.data.tags and e.data.tags.length %}Archived in {{ e.data.tags | join(" | ") }} <br>{% endif %}Read on, <a href="{{ e.url }}">there is more &rarr;</a></p>
{%- endif %}
