{#- One entry in the stream (home, journal, category pages), Seth Godin's way: the date, the title, the words.
    Quotes and notes are shown whole; an essay shows its opening paragraph and a link on. Expects: e. -#}
<article class="post">
<p class="date"><time datetime="{{ e.date | dateISO }}">{{ e.date | dateLong | safe }}</time></p>
{%- if e.data.type == "quote" %}
{%- set qhtml = e.templateContent %}
{%- include "partials/quote-panel.njk" %}
{%- elif e.data.type == "note" %}
<h2><a href="{{ e.url }}">{{ e.data.title }}</a></h2>
<div class="post-body">{{ e.templateContent | listingRefs(e.url) | safe }}</div>
{%- else %}
<h2><a href="{{ e.url }}">{{ e.data.title }}</a></h2>
<div class="post-body"><p>{{ e.templateContent | firstParagraph | listingRefs(e.url) | safe }}</p></div>
<p class="read-on"><a href="{{ e.url }}">Continue reading ({{ e.templateContent | readingTime }} min) &rarr;</a></p>
{%- endif %}
<p class="post-foot">{% if e.data.tags and e.data.tags.length %}{% for t in e.data.tags %}<a href="/journal/category/{{ t | slugify }}/">{{ t }}</a>{% if not loop.last %}, {% endif %}{% endfor %} · {% endif %}<a href="{{ e.url }}">Permalink</a></p>
</article>
