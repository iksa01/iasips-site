---
layout: layouts/base.njk
bodyClass: home
---
{#- Home (2026-11 design): one line about Kalyan, then the newest entries in full, as on seths.blog. -#}
{%- if site.intro %}<p class="intro">{{ site.intro | safe }} <a href="/about/">More about me &rarr;</a></p>{% endif %}
{%- set entries = collections.journal | limit(10) %}
{%- for e in entries %}
{%- set again = loop.index0 > 0 and (entries[loop.index0 - 1].date | dateISO) == (e.date | dateISO) %}
{%- include "partials/index-entry.njk" %}
{%- endfor %}
{%- if collections.journal.length > 10 %}
<p class="more-link"><a href="/journal/page/2/">Older entries &rarr;</a> &nbsp;·&nbsp; <a href="/archive/">Everything, by month</a></p>
{%- else %}
<p class="more-link"><a href="/archive/">Everything, by month &rarr;</a></p>
{%- endif %}
