<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121416" media="(prefers-color-scheme: dark)">
<title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
{#- Search, previews and AI answer engines (design change 2026-11-24, DESIGN §4a). -#}
{%- set pageDescription = (description or sub or site.description) | striptags %}
{%- set pageUrl = site.url + page.url %}
{%- set xHref = "" %}{% for x in site.externals %}{% if x.label == "X" %}{% set xHref = x.href %}{% endif %}{% endfor %}
{%- set shareImg = firstImage.src if firstImage else site.ogImage %}
{%- set shareAlt = (firstImage.alt if firstImage else "") %}
<meta name="description" content="{{ pageDescription | escape }}">
<meta name="author" content="{{ site.author }}">
{%- if page.url != "/404.html" %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{%- endif %}
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:type" content="{% if bodyId == "article" %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ (title or site.title) | escape }}">
<meta property="og:description" content="{{ pageDescription | escape }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{%- if shareImg %}
<meta property="og:image" content="{{ site.url }}{{ shareImg }}">
{%- if shareAlt %}<meta property="og:image:alt" content="{{ shareAlt | escape }}">{% endif %}
{%- endif %}
<meta name="twitter:card" content="{{ "summary_large_image" if shareImg else "summary" }}">
{%- if xHref %}<meta name="twitter:site" content="@{{ xHref | replace("https://x.com/", "") }}">{% endif %}
{%- if bodyId == "article" %}
<meta property="article:published_time" content="{{ page.date | dateISO }}">
{%- if updated %}<meta property="article:modified_time" content="{{ updated | dateISO }}">{% endif %}
<meta property="article:author" content="{{ site.url }}/about/">
{%- if tags and tags.length %}<meta property="article:section" content="{{ tags[0] }}">{% endif %}
{%- for t in tags %}<meta property="article:tag" content="{{ t }}">{% endfor %}
{%- endif %}
<script type="application/ld+json">{{ {
  site: site, page: page, pageUrl: pageUrl, title: title, description: pageDescription,
  bodyId: bodyId, tags: tags, updated: updated, type: type, link: link, linkAuthor: linkAuthor,
  quoteWords: quoteWords, quoteBy: quoteBy, shareImg: shareImg
} | jsonLd | safe }}</script>
{%- if bodyId == "article" %}
{%- set olderHead = collections.journal | getNextCollectionItem %}
{%- set newerHead = collections.journal | getPreviousCollectionItem %}
{%- if olderHead %}<link rel="prev" href="{{ olderHead.url }}">{% endif %}
{%- if newerHead %}<link rel="next" href="{{ newerHead.url }}">{% endif %}
{%- endif %}
<style>{% inlineCss %}</style>
<link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
</head>
<body class="{{ bodyClass }}"{% if bodyId %} id="{{ bodyId }}"{% endif %}>
<a class="skip" href="#content">Skip to the text</a>
<div id="page">
<header>
{% include "partials/masthead.njk" %}
{% include "partials/nav.njk" %}
</header>
<main id="content">
{{ content | safe }}
</main>
<footer>
{% include "partials/siteinfo.njk" %}
</footer>
</div>
</body>
</html>
