---
layout: layouts/base.njk
bodyClass: external
---
{% from "partials/card.njk" import card %}
{%- set S = engravingSamples %}
<div class="samples">
<p class="samples-lede">{{ sub }}</p>

<h3 class="sample-head">{{ S.proposed.name }} <span>{{ S.proposed.note }}</span></h3>
<ul class="subnav">
{%- for slot in S.proposed.cards %}
{%- set n = site.nav[loop.index0] %}
{{ card({ href: "#pool", strap: n.strap, label: n.label, kern: n.kern, engraving: "/images/engravings/gosse/" + slot + ".png" }, false) }}
{%- endfor %}
</ul>

<h3 class="sample-head" id="pool">{{ S.pool.name }} <span>{{ S.pool.note }}</span></h3>
<ul class="pool">
{%- for it in S.pool.items %}
<li><img src="/images/engravings/gosse/{{ it.slug }}.png" alt="{{ it.label }}"><span>{{ it.label }}</span></li>
{%- endfor %}
</ul>

<h3 class="sample-head">{{ S.old.name }} <span>{{ S.old.note }}</span></h3>
{%- for row in S.old.rows %}
<ul class="subnav faded">
{%- for slot in row.cards %}
{%- set n = site.nav[loop.index0] %}
{{ card({ href: "#pool", strap: n.strap, label: n.label, kern: n.kern, engraving: "/images/engravings/samples/" + slot + ".png" }, false) }}
{%- endfor %}
</ul>
{%- endfor %}

<p class="samples-foot">Sources and licences: <code>images/engravings/CREDITS.md</code>. Working page — not part of the site.</p>
</div>
