---
layout: layouts/base.njk
bodyClass: journal
bodyId: article
---
{%- set older = collections.journal | getNextCollectionItem %}
{%- set newer = collections.journal | getPreviousCollectionItem %}
{%- set tocItems = content | toc if toc else [] %}
<div class="row entry-row">
{%- set sd = page.date %}{% set stags = tags %}{% set slink = "" %}{% set supdated = updated or "" %}{% set sagain = false %}
{%- set smins = (content | readingTime) if (type != "quote" and type != "note") else "" %}
{%- include "partials/side.njk" %}
<div class="main">
{%- if type == "quote" %}
{%- set qhtml = content %}{% set parts = qhtml | quoteParts %}
<div id="post">
<h1 class="sr-only">{{ title }}</h1>
{%- include "partials/quote-panel.njk" %}
{%- if parts.commentary | trim %}
<hr>
<div class="entry commentary">{{ parts.commentary | safe }}</div>
{%- endif %}
</div>
{%- else %}
<h1 class="page-title">{{ title }}</h1>
{% if sub %}<p class="sub">{{ sub }}</p>{% endif %}
{%- if tocItems.length %}
<div class="toc-inline"><h3>In this entry</h3>{% include "partials/toc-list.njk" %}</div>
{%- endif %}
<article id="post" class="entry{% if dropcap %} dropcap{% endif %}">
{{ content | safe }}
</article>
{%- endif %}
</div>
</div>
{%- if older or newer %}
<p class="paginate"><span>{% if older %}<a href="{{ older.url }}"><small>&larr; Older</small>{{ older.data.title }}</a>{% endif %}</span><span>{% if newer %}<a href="{{ newer.url }}"><small>Newer &rarr;</small>{{ newer.data.title }}</a>{% endif %}</span></p>
{%- endif %}
