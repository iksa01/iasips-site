---
layout: layouts/base.njk
bodyClass: archive
---
<div id="content-wrap">
<div id="content-pri">
<h1 class="page-title">{{ title }}</h1>
{% if sub %}<p class="sub">{{ sub }}</p>{% endif %}
<ul>
{%- for g in collections.journal | byMonth %}
<li class="date-heading" id="{{ g.year }}-{{ g.month | lower }}">{{ g.month }} {{ g.year }}</li>
{%- for e in g.items %}
<li><a href="{{ e.url }}">{{ e.data.title }}</a></li>
{%- endfor %}
{%- endfor %}
</ul>
</div>
<div id="content-sec">
<p class="home-link"><a href="/">Home</a></p>
<h3>By year</h3>
<ul>
{%- for g in collections.journal | byYear %}
<li><a href="#{{ g.year }}-{{ (g.items[0].date | monthName) | lower }}">{{ g.year }}</a></li>
{%- endfor %}
</ul>
<h3>By category</h3>
<ul>
{%- for t in collections.journal | tagList %}
<li><a href="/journal/category/{{ t | slugify }}/">{{ t }}</a></li>
{%- endfor %}
</ul>
</div>
</div>
