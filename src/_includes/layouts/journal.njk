---
layout: layouts/base.njk
bodyClass: journal
bodyId: multiple
---
<div id="content-wrap">
<div id="content-pri">
<h1 class="page-title">{{ title }}</h1>
{% if sub %}<p class="sub">{{ sub }}</p>{% endif %}
{%- set entries = (collections[tag] | reverse) if tag else collections.journal %}
{%- for e in entries %}
{%- include "partials/index-entry.njk" %}
{%- endfor %}
</div>
<div id="content-sec">
<p class="home-link"><a href="/">Home</a></p>
<h3>Categories</h3>
<ul>
{%- for t in collections.journal | tagList %}
<li><a href="/journal/category/{{ t | slugify }}/">{{ t }}</a></li>
{%- endfor %}
</ul>
{%- if site.favourites and site.favourites.length %}
<h3>{{ site.favouritesHeading }}</h3>
<ul>
{%- for f in site.favourites %}
<li><a href="{{ f.href }}">{{ f.title }}</a></li>
{%- endfor %}
</ul>
{%- endif %}
</div>
</div>
