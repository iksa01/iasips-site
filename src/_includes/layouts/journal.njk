---
layout: layouts/base.njk
bodyClass: journal
bodyId: multiple
---
<div id="content-wrap">
<div id="content-pri">
<h1 class="page-title">{{ title }}</h1>
{% if sub %}<p class="sub">{{ sub }}</p>{% endif %}
{%- set entries = (collections[tag] | reverse) if tag else (pageEntries or collections.journal) %}
{%- for e in entries %}
{%- include "partials/index-entry.njk" %}
{%- endfor %}
{%- if pageEntries and pagination.pages.length > 1 %}
{#- page numbers (design change 2026-09-26): 20 entries a page, newest first -#}
<p class="pages"><span>{% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">&larr; Newer</a>{% endif %}</span><span class="count">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span><span>{% if pagination.href.next %}<a href="{{ pagination.href.next }}">Older &rarr;</a>{% endif %}</span></p>
{%- endif %}
</div>
<div id="content-sec">
<p class="home-link"><a href="/">Home</a></p>
<h3>Categories</h3>
<ul>
{%- for t in collections.journal | tagList %}
<li><a href="/journal/category/{{ t | slugify }}/">{{ t }}</a></li>
{%- endfor %}
</ul>
{%- if site.favourites and site.favourites.length %}
<h3>{{ site.favouritesHeading }}</h3>
<ul>
{%- for f in site.favourites %}
<li><a href="{{ f.href }}">{{ f.title }}</a></li>
{%- endfor %}
</ul>
{%- endif %}
</div>
</div>
